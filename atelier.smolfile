# Docker Engine in a systemd-enabled Ubuntu 26.04 SmolVM.
#
# Create the machine:
#
# smolvm machine create --name atelier --net-backend virtio-net \
#   --smolfile atelier.smolfile
#
# Tailscale's normal Linux mode needs virtio-net for a real guest NIC and
# default route. smolvm does not currently support net_backend in a Smolfile.

# this image has systemd
image = "buluma/docker-molecule-images:ubuntu2604"

cpus = 4
memory = 8192
net = true
storage = 40

docker_socket = true

# Run on every VM start.
init = [
  "apt-get update",
  # "apt-get install -y curl docker.io",
  # Recreate the TUN device on the temporary /dev filesystem; Tailscale needs it.
  "printf '%s\n' 'd /dev/net 0755 root root -' 'c /dev/net/tun 0600 root root - 10:200' > /etc/tmpfiles.d/tailscale-tun.conf",
  # Apply the rule now, so Tailscale can start during this provisioning run.
  "systemd-tmpfiles --create /etc/tmpfiles.d/tailscale-tun.conf",
  "mkdir -p /storage/docker /var/lib/docker /storage/containerd /var/lib/containerd",
  # Docker and containerd state must be on the ext4-backed /storage disk to avoid overlay on overlay.
  "grep -qxF '/storage/docker /var/lib/docker none bind 0 0' /etc/fstab || echo '/storage/docker /var/lib/docker none bind 0 0' >> /etc/fstab",
  "grep -qxF '/storage/containerd /var/lib/containerd none bind 0 0' /etc/fstab || echo '/storage/containerd /var/lib/containerd none bind 0 0' >> /etc/fstab",
]
